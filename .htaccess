# ── 4. Legacy mixed-case .html URLs → lowercase clean URLs ──
RewriteRule ^Shop\.html$ https://discoverparbat.com/shop [R=301,L,NC]
RewriteRule ^Kokhe-Danda-Trek\.html$ https://discoverparbat.com/kokhe-danda-trek [R=301,L,NC]
RewriteRule ^Short-Kokhe-Danda-Trek\.html$ https://discoverparbat.com/short-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^Mardi-Himal-Trek\.html$ https://discoverparbat.com/mardi-himal-trek [R=301,L,NC]
RewriteRule ^Khopra-Danda-Trek\.html$ https://discoverparbat.com/khopra-ridge-trek [R=301,L,NC]
RewriteRule ^Annapurna-Base-Camp-Trek\.html$ https://discoverparbat.com/annapurna-base-camp-trek [R=301,L,NC]
RewriteRule ^Multiple-Viewpoints-Trek\.html$ https://discoverparbat.com/multiple-viewpoints-trek [R=301,L,NC]
RewriteRule ^muldai-viewpoint-trek\.html$ https://discoverparbat.com/muldai-viewpoint-trek [R=301,L,NC]
RewriteRule ^Why-Discover-Parbat-For-Kokhe-Danda-Trek\.html$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L,NC]
RewriteRule ^why-kokhe-danda-trek\.html$ https://discoverparbat.com/article/why-kokhe-danda-trek [R=301,L,NC]

# index.html → homepage (must come before the general .html rule)
RewriteCond %{THE_REQUEST} \s/+index\.(html|php)[\s?] [NC]
RewriteRule ^ https://discoverparbat.com/ [R=301,L]

# Any other .html URL → extensionless (301), except the Google verification file
RewriteCond %{REQUEST_URI} !^/google[0-9a-f]+\.html$ [NC]
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)\.html[\s?] [NC]
RewriteRule ^ https://discoverparbat.com/%1 [R=301,L,NE]

# Trailing slash on a page URL → no slash (one URL per page, Nov 2026).
# Real folders (article/, photo/, cms/ …) are left alone.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ https://discoverparbat.com/$1 [R=301,L]

# ── 5. Internal routing (no redirects) ──
DirectoryIndex index.html index.php

# Static article pages: /article/slug → article/slug.html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^article/([a-z0-9-]+)/?$ article/$1.html [L]

# Dynamic CMS pages
RewriteRule ^articles/?$ articles.php [L]
RewriteRule ^article/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]
RewriteRule ^treks/?$ treks.php [L]

# Clean URLs → trek.php (CMS page or static .html fallback inside trek.php)
   # Only the repo's real folders are skipped, so a leftover folder on the
   # server (e.g. an old about/) can no longer hijack a page URL.
   RewriteCond %{REQUEST_URI} !^/(article|cms|includes|lib|photo|prints|scripts|uploads)(/|$) [NC]
   RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([a-z0-9-]+)/?$ trek.php?slug=$1 [L,QSA]
